# Required. Used for chat completions (default provider) and for embeddings.
OPENAI_API_KEY=

# Optional. Only needed when LLM_PROVIDER=anthropic. Embeddings still use OpenAI.
ANTHROPIC_API_KEY=

# openai or anthropic
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-opus-5
EMBEDDING_MODEL=text-embedding-3-small

# Site to ingest and the storage paths for the index and the agent checkpoints.
SITE_URL=https://henet.com.br
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=henet
CHECKPOINT_DB=data/checkpoints.sqlite

# Shared secret for POST /ingest. Leave empty to disable the endpoint.
INGEST_TOKEN=

# Origins allowed to call the API from a browser, separated by commas.
CORS_ORIGINS=http://localhost:3000

# Retrieval and agent limits.
TOP_K=6
MAX_REWRITES=2
RECURSION_LIMIT=25

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
